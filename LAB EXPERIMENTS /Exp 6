import cv2
import matplotlib.pyplot as plt
import numpy as np
image = cv2.imread("image.jpg")
gray_image = cv2.cvtColor(
image,
cv2.COLOR_BGR2GRAY
)
kernel = np.ones(
(5,5),
np.uint8
)
eroded_image = cv2.erode(
gray_image,
kernel,
iterations=1
)
plt.figure(figsize=(10,4))
plt.subplot(1,2,1)
plt.imshow(
gray_image,
cmap="gray"
)
plt.title("Original␣Image")
plt.axis("off")
plt.subplot(1,2,2)
plt.imshow(
eroded_image,
cmap="gray"
)
plt.title("Eroded␣Image")
plt.axis("off")
plt.show()
