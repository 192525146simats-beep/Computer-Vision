import cv2
video = cv2.VideoCapture(
"video.mp4"
)
if not video.isOpened():
print("Error␣opening␣video")
while True:
ret, frame = video.read()
if ret == False:
break
cv2.imshow(
"Normal␣Video",
frame
)
key = cv2.waitKey(100)
if key == ord(’s’):
cv2.imshow(
"Slow␣Motion",
frame
)
cv2.waitKey(200)
if key == ord(’f’):
cv2.imshow(
"Fast␣Motion",
frame
)
cv2.waitKey(10)
if key == ord(’q’):
break
video.release()
cv2.destroyAllWindows()
